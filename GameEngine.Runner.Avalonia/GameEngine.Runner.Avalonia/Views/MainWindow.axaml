<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GameEngine.Runner.Avalonia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:GameEngine.Runner.Avalonia.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="GameEngine.Runner.Avalonia.Views.MainWindow"
        Icon="/Assets/avalonia-logo.ico"
        Title="GameEngine.Runner.Avalonia"
		xmlns:local="using:GameEngine.Runner.Avalonia">
        <local:GameView />
</Window>
