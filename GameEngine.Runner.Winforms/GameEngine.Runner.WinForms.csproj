<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- SkiaSharp.Views.WindowsForms only offers its modern OpenTK 4.x assets to
         net10.0-windows10.0.19041; a lower Windows target silently falls back to its
         .NET Framework group, which is what NU1701 was reporting. -->
    <TargetFramework>net10.0-windows10.0.19041</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.Views.WindowsForms" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\GameEngine.Demo\GameEngine.Demo.csproj" />
    <ProjectReference Include="..\GameEngine.Audio.Sdl\GameEngine.Audio.Sdl.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="libegl.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>