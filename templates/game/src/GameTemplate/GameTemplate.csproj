<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>GameTemplate</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="GameEngine.Core" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>
  <ItemGroup>
    <None Update="assets.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="assets\**" CopyToOutputDirectory="PreserveNewest" />
    <None Update="levels\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
