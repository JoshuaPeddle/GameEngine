<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>GameTemplate.Browser</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Browser" />
    <PackageReference Include="GameEngine.Runner.Avalonia" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\GameTemplate\GameTemplate.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="..\GameTemplate\assets.json" Link="Assets\assets.json" />
    <AvaloniaResource Include="..\GameTemplate\assets\**\*.*" Link="Assets\game\%(RecursiveDir)%(FileName)%(Extension)" />
    <AvaloniaResource Include="..\GameTemplate\levels\**\*.*" Link="Assets\game\levels\%(RecursiveDir)%(FileName)%(Extension)" />
  </ItemGroup>
</Project>
