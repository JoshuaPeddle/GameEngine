<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <RootNamespace>GameTemplate.Android</RootNamespace>
    <ApplicationId>com.example.GameTemplate</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
  </PropertyGroup>
  <ItemGroup>
    <AndroidResource Include="Icon.png">
      <Link>Resources\drawable\Icon.png</Link>
    </AndroidResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" />
    <PackageReference Include="GameEngine.Runner.Avalonia" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\GameTemplate\GameTemplate.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AndroidAsset Include="..\GameTemplate\assets.json" Link="Assets\assets.json" />
    <AndroidAsset Include="..\GameTemplate\assets\**\*.*" Link="Assets\game\%(RecursiveDir)%(FileName)%(Extension)" />
    <AndroidAsset Include="..\GameTemplate\levels\**\*.*" Link="Assets\game\levels\%(RecursiveDir)%(FileName)%(Extension)" />
  </ItemGroup>
</Project>
