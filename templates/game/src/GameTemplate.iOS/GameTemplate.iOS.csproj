<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>13.0</SupportedOSPlatformVersion>
    <RootNamespace>GameTemplate.iOS</RootNamespace>
    <ApplicationId>com.example.GameTemplate</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <CodesignEntitlements>Entitlements.plist</CodesignEntitlements>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.iOS" />
    <PackageReference Include="GameEngine.Runner.Avalonia" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\GameTemplate\GameTemplate.csproj" />
  </ItemGroup>
  <ItemGroup>
    <BundleResource Include="..\GameTemplate\assets.json" Link="assets.json" />
    <BundleResource Include="..\GameTemplate\assets\**\*.*" Link="assets\%(RecursiveDir)%(FileName)%(Extension)" />
    <BundleResource Include="..\GameTemplate\levels\**\*.*" Link="levels\%(RecursiveDir)%(FileName)%(Extension)" />
  </ItemGroup>
</Project>
