<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="clr-namespace:GameEngine.Editor.ViewModels"
             x:Class="GameEngine.Editor.Controls.ProjectEditor"
             x:DataType="vm:ProjectEditorViewModel">

    <Design.DataContext>
        <vm:ProjectEditorViewModel />
    </Design.DataContext>

    <Border Padding="10">
        <StackPanel Orientation="Vertical" Spacing="10">
            <TextBlock Text="{Binding ProjectName}" Width="400" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Open..." Command="{Binding OpenProjectCommand}" />
                <Button Content="Save Project" Command="{Binding SaveProjectCommand}" />
            </StackPanel>

            <Separator/>

            <TextBlock Text="New Game" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Width="220"
                         Watermark="Game name"
                         Text="{Binding NewProjectName, Mode=TwoWay}"/>
                <Button Content="New Game..." Command="{Binding NewProjectCommand}" />
                <TextBlock Text="{Binding NewProjectStatus}" VerticalAlignment="Center" Foreground="Gray"/>
            </StackPanel>
            <TextBlock Text="Creates a project from the gameengine-game template: one scene, one level, every platform head, and tests."
                       TextWrapping="Wrap" Foreground="Gray" FontSize="11"/>

            <Separator/>

            <TextBlock Text="Recent Projects" FontWeight="Bold"/>
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto">
                <ListBox Grid.Row="0" Grid.Column="0"
                         ItemsSource="{Binding RecentProjects}"
                         SelectedItem="{Binding SelectedRecentProject}"
                         MinHeight="150"
                         DoubleTapped="RecentProjects_DoubleTapped">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Vertical" Spacing="6" Margin="8,0,0,0">
                    <Button Content="Open Selected"
                            Command="{Binding OpenSelectedRecentProjectCommand}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
