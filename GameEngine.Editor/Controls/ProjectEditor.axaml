<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:vm="clr-namespace:GameEngine.Editor.ViewModels"
             x:Class="GameEngine.Editor.Controls.ProjectEditor"
			 x:DataType="vm:ProjectEditorViewModel">

	<Design.DataContext>
		<vm:ProjectEditorViewModel />
	</Design.DataContext>
	
	<Border >
		<StackPanel Orientation="Vertical" Spacing="10" Margin="10">
			<TextBlock Text="{Binding ProjectName}"  Width="400" Margin="0,10,0,10"/>
			<Button Content="Open" Command="{Binding OpenProjectCommand}" />
			<Button Content="Save Project" Command="{Binding SaveProjectCommand}" />
		</StackPanel>
	</Border>     
  
</UserControl>
