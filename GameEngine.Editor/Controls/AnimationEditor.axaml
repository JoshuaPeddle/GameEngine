<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="450"
			 xmlns:vm="clr-namespace:GameEngine.Editor.ViewModels"
             x:Class="GameEngine.Editor.Controls.AnimationEditor"
			 x:DataType="vm:AnimationEditorViewModel">

	<Design.DataContext>
		<vm:AnimationEditorViewModel />
	</Design.DataContext>
	<Grid ColumnDefinitions="200,150,*" RowDefinitions=""  Margin="4">
		<Border Background="AliceBlue" Grid.Row="1" Grid.Column="0">
			<ListBox ItemsSource="{Binding Animations}">
				<ListBox.ItemTemplate>
					<DataTemplate>
						<StackPanel Orientation="Vertical">
							<TextBlock Text="{Binding Name}" Margin="0,0,10,0"/>
							<Image Source="{Binding Texture.Bitmap^}" Width="100" Height="100" RenderOptions.BitmapInterpolationMode="HighQuality"/>
						</StackPanel>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</Border>
		<Border Background="AliceBlue" Grid.Row="1" Grid.Column="1" Margin="1,0,0,0">
			<ListBox ItemsSource="{Binding Textures}" SelectedItem="{Binding SelectedTexture}">
				<ListBox.ItemTemplate>
					<DataTemplate>
						<StackPanel Orientation="Vertical">
							<TextBlock Text="{Binding Name}" Margin="0,0,10,0"/>
							<Image Source="{Binding Bitmap^}" Width="100" Height="100" RenderOptions.BitmapInterpolationMode="HighQuality"/>
						</StackPanel>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</Border>
		<Border Background="White" Grid.Row="0" Grid.Column="2">
			<Grid ColumnDefinitions="*" RowDefinitions="60,*"  Margin="0"  RenderOptions.BitmapInterpolationMode="HighQuality">
				<Border Background="DarkGray">
					<StackPanel Orientation="Horizontal" Spacing="10">
						<Button Margin="10,0,0,0" Classes="ControlButton" Command="{Binding SaveAnimationCommand}" IsEnabled="{Binding SaveButtonEnabled}">Save</Button>
						<TextBox Classes="TexName" Watermark="Amimation Name" Text="{Binding AnimationName}" Width="300" Margin="0,10,0,10"/>
						<TextBox Classes="TexFrames" Watermark="Frame Count" Text="{Binding FrameCount}" Width="130" Margin="0,10,0,10"/>
						<TextBox Classes="TexName" Watermark="Frame Delay(ms)" Text="{Binding FrameDelay}" Width="130" Margin="0,10,0,10"/>
						<CheckBox IsChecked="{Binding Animate}">Animate</CheckBox>
					</StackPanel>
				</Border>
				<Image Grid.Row="1" Grid.Column="1" Source="{Binding Image}"  RenderOptions.BitmapInterpolationMode="HighQuality"/>
			</Grid>
		</Border>
	</Grid>
</UserControl>
