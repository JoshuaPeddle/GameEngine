<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="450"
			 xmlns:vm="clr-namespace:GameEngine.Editor.ViewModels"
             x:Class="GameEngine.Editor.Controls.AnimationEditor"
			 x:DataType="vm:AnimationEditorViewModel">

	<Design.DataContext>
		<vm:AnimationEditorViewModel />
	</Design.DataContext>

	<UserControl.Styles>
		<Style Selector="Button.ControlButton">
			<Setter Property="FontSize" Value="22"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Foreground" Value="Black"/>
			<Setter Property="Background" Value="White"/>
		</Style>
		<Style Selector="TextBox.TexInput">
			<Setter Property="FontSize" Value="22"/>
			<Setter Property="FontWeight" Value="Bold"/>
		</Style>
		<Style Selector="CheckBox.ChkAnimate">
			<Setter Property="FontSize" Value="22"/>
			<Setter Property="FontWeight" Value="Bold"/>
		</Style>
	</UserControl.Styles>

	<Grid ColumnDefinitions="200,1,150,1,*" Margin="4">
		<Border Background="AliceBlue"  Grid.Column="0">
			<ListBox ItemsSource="{Binding Animations}">
				<ListBox.ItemTemplate>
					<DataTemplate>
						<StackPanel Orientation="Vertical">
							<TextBlock Text="{Binding Name}" Margin="0,0,10,0"/>
							<Image Source="{Binding Texture.Bitmap^}" Width="100" Height="100" RenderOptions.BitmapInterpolationMode="HighQuality"/>
						</StackPanel>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</Border>
		<GridSplitter Grid.Column="1"  Background="LightGray" ResizeDirection="Columns"/>
		<Border Background="AliceBlue" Grid.Column="2" >
			<ListBox ItemsSource="{Binding Textures}" SelectedItem="{Binding SelectedTexture}">
				<ListBox.ItemTemplate>
					<DataTemplate>
						<StackPanel Orientation="Vertical">
							<TextBlock Text="{Binding Name}" Margin="0,0,10,0"/>
							<Image Source="{Binding Bitmap^}" Width="100" Height="100" RenderOptions.BitmapInterpolationMode="HighQuality"/>
						</StackPanel>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</Border>
		<GridSplitter Grid.Column="3"  Background="LightGray" ResizeDirection="Columns"/>
		<Border Background="White"  Grid.Column="4">
			<Grid ColumnDefinitions="*" RowDefinitions="60,*"  Margin="0"  RenderOptions.BitmapInterpolationMode="HighQuality">
				<Border Background="DarkGray">
					<StackPanel Orientation="Horizontal" Spacing="10">
						<Button Margin="10,0,0,0" Classes="ControlButton" Command="{Binding SaveAnimationCommand}">Save</Button>
						<TextBox Classes="TexInput" Watermark="Amimation Name" Text="{Binding AnimationName}" Width="300" Margin="0,10,0,10"/>
						<TextBox Classes="TexInput" Watermark="Frame Count" Text="{Binding FrameCount}" Width="130" Margin="0,10,0,10"/>
						<TextBox Classes="TexInput" Watermark="Frame Delay(ms)" Text="{Binding FrameDelay}" Width="130" Margin="0,10,0,10"/>
						<CheckBox Classes="ChkAnimate" IsChecked="{Binding Animate}">Animate</CheckBox>
					</StackPanel>
				</Border>
				<Image Grid.Row="1" Grid.Column="1" Source="{Binding Image}"  RenderOptions.BitmapInterpolationMode="HighQuality"/>
			</Grid>
		</Border>
	</Grid>
</UserControl>
