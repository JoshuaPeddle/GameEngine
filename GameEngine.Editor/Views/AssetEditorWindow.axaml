<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="600"
        Title="Window1"
        x:Class="GameEngine.Editor.AssetEditorWindow"
		xmlns:uc="clr-namespace:GameEngine.Editor.Controls"
		xmlns:vm="clr-namespace:GameEngine.Editor.ViewModels"
		xmlns:views="using:GameEngine.Editor.ViewModels"
		x:DataType="vm:AssetEditorViewModel">
	<Design.DataContext>
		<vm:AssetEditorViewModel />
	</Design.DataContext>
	
	<Window.Styles>
		<Style Selector="TabControl WrapPanel">
			<Setter Property="MaxHeight" Value="20"/>
			<Setter Property="Margin" Value="0,5,0,10"/>
		</Style>
	</Window.Styles>

	<DockPanel>
		<TabControl Margin="0,10"  DockPanel.Dock="Top">
			<TabItem Header="Project">
				<uc:ProjectEditor DataContext="{Binding ProjectEditor}" />
			</TabItem>
			<TabItem Header="Texture Editor">
				<uc:TextureEditor DataContext="{Binding TextureEditor}" />
			</TabItem>
			<TabItem Header="Animation Editor">
				<uc:AnimationEditor DataContext="{Binding AnimationEditor}" />
			</TabItem>
			<TabItem Header="Level Editor">
				<uc:LevelEditor DataContext="{Binding LevelEditor}" />
			</TabItem>
		</TabControl>
	</DockPanel>
</Window>
