<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GameEngine.Editor.App"
             RequestedThemeVariant="Default"
             xmlns:converters="clr-namespace:GameEngine.Editor.Converters">
  <!-- Add a theme and default styles -->
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>
</Application>
